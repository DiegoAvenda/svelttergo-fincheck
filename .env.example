# Copia este archivo a .env y coloca tus keys reales.
# Nunca subas .env a git.

ORIGIN="http://localhost:5173"

BETTER_AUTH_SECRET="cambia-esto-por-un-secreto-largo"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=finchek

# --- IA para lectura de tickets (OpenRouter, modelos free) ---
# 1. Crea tu key en https://openrouter.ai/keys
# 2. Pegala abajo. Ejemplo de key: sk-or-v1-abc123...
OPENROUTER_API_KEY=
# Modelo principal con vision (free). Si deja de estar free, prueba otro de:
# https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=qwen/qwen2.5-vl-72b-instruct:free
# Opción C híbrida con visión: Qwen VL -> Nemotron Nano 12B VL (buen OCR) -> openrouter/free.
# Alternativa omni con visión+video+audio: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# OJO: nvidia/nemotron-3-nano-30b-a3b:free y nvidia/nemotron-3-ultra-550b-a55b:free son SOLO TEXTO (no ven fotos).
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# reasoning effort para modelos MoE/reasoning ('none' recomendado para extracciones estructuradas JSON):
OPENROUTER_REASONING_EFFORT=none
OPENROUTER_APP_URL=http://localhost:5173
OPENROUTER_APP_TITLE=Fincheck Tickets
OPENROUTER_TIMEOUT_MS=60000

# --- Fallback opcional Anthropic (si lo quieres mantener) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
